{
  "name": "cuteness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cuteness/src",
  "prefix": "cuteness",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/cuteness",
        "index": "apps/cuteness/src/index.html",
        "main": "apps/cuteness/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/cuteness/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/cuteness/src/favicon.ico",
          "apps/cuteness/src/assets"
        ],
        "styles": [
          "@angular/material/prebuilt-themes/purple-green.css",
          "apps/cuteness/src/styles.scss"
        ],
        "scripts": [],
        "webWorkerTsConfig": "apps/cuteness/tsconfig.worker.json",
        "serviceWorker": true,
        "ngswConfigPath": "apps/cuteness/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "fonts": {
              "inline": true
            },
            "styles": {
              "minify": true,
              "inlineCritical": false
            }
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "cuteness:build:production"
        },
        "development": {
          "buildTarget": "cuteness:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "cuteness:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/cuteness/jest.config.ts",
        "webWorkerTsConfig": "apps/cuteness/tsconfig.worker.json"
      }
    },
    "deploy": {
      "executor": "angular-cli-ghpages:deploy",
      "options": {
        "baseHref": "/cuteness/"
      }
    }
  },
  "tags": []
}