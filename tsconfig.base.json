{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2023",
    "module": "esnext",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@cuteness/rsa": ["./libs/rsa/src/index.ts"],
      "@cuteness/travelling-salesman-problem": ["./libs/travelling-salesman-problem/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
